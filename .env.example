# =====================================================================
#  НАСТРОЙКИ «АУДИТОРА ВСТРЕЧ»
#  Впишите ключи сразу после знака = (без пробелов и кавычек),
#  сохраните файл (Ctrl+S) и запустите run.bat.
# =====================================================================

# ШАГ 1. Ключ для расшифровки речи.
# Где взять: зарегистрируйтесь на https://www.assemblyai.com
# (при регистрации дают $50 — это сотни часов записей), затем Dashboard → API Keys.
ASSEMBLYAI_API_KEY=

# ШАГ 2. Ключ для анализа встречи. Нужен ОДИН из вариантов ниже.
#
# Вариант А — OpenAI (https://platform.openai.com → API keys):
OPENAI_API_KEY=
#   Если ключ выдан посредником (например, AITunnel или OpenRouter),
#   уберите решётку в начале строки ниже и впишите его адрес:
# OPENAI_BASE_URL=https://api.aitunnel.ru/v1/
#
# Вариант Б — Claude (https://console.anthropic.com → API Keys):
#   впишите ключ и замените openai на anthropic в строке LLM_PROVIDER.
ANTHROPIC_API_KEY=
LLM_PROVIDER=openai


# ---------------------------------------------------------------------
#  Дальше можно ничего не трогать
# ---------------------------------------------------------------------

# Модель анализа. gpt-4o-mini дешевле, но ошибается в подсчёте баллов; gpt-4.1 проверку проходит чисто.
OPENAI_MODEL=gpt-4.1
ANTHROPIC_MODEL=claude-sonnet-5-5

# Распознавание: universal-2 поддерживает русский язык.
ASSEMBLYAI_SPEECH_MODEL=universal-2
ASSEMBLYAI_LANGUAGE=ru

# Максимальная длина ответа модели (отчёт из 13 разделов — примерно 6–12 тыс. токенов).
LLM_MAX_TOKENS=16000

# Пароль на вход. Нужен, только если приложение будет доступно из интернета.
APP_PASSWORD=
