# Скопируйте в .env и заполните.

# --- Распознавание речи: https://www.assemblyai.com (при регистрации $50 бесплатных кредитов) ---
ASSEMBLYAI_API_KEY=
# universal-2 поддерживает русский; universal-3-5-pro — нет
ASSEMBLYAI_SPEECH_MODEL=universal-2
ASSEMBLYAI_LANGUAGE=ru

# --- Анализ: openai | anthropic ---
LLM_PROVIDER=openai

# OpenAI (или любой OpenAI-совместимый API — тогда заполните OPENAI_BASE_URL)
OPENAI_API_KEY=
# gpt-4o-mini дешевле, но ошибается в арифметике баллов; gpt-4.1 проходит проверку отчёта чисто
OPENAI_MODEL=gpt-4.1
# Примеры: https://api.aitunnel.ru/v1/  ·  https://openrouter.ai/api/v1
# OPENAI_BASE_URL=

# Claude API (LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Лимит длины ответа модели. Отчёт из 13 разделов — примерно 6–12 тыс. токенов.
# У gpt-4o-mini максимум 16384.
LLM_MAX_TOKENS=16000

# Пароль на вход (Basic Auth) — обязательно задайте при публичном деплое
APP_PASSWORD=
